/*
 * Ergodash (rev 1.2) ZMK keymap, converted from QMK keymap.c (LAYOUT_4key).
 * Each layer has 70 bindings in the same order as the QMK layout:
 * 5 rows of 14 (7 left | 7 right), read left to right, top to bottom.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&kp ESC     &kp N1    &kp N2    &kp N3    &kp N4  &kp N5     &kp LBKT       &kp RBKT   &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp PSCRN
&kp TAB     &kp Q     &kp W     &kp E     &kp R   &kp T      &kp MINUS      &kp EQUAL  &kp Y   &kp U   &kp I      &kp O    &kp P     &kp BSLH
&kp GRAVE   &kp A     &kp S     &kp D     &kp F   &kp G      &kp DEL        &kp BSPC   &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT   &kp Z     &kp X     &kp C     &kp V   &kp B      &kp LSHFT      &kp RET    &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
&kp LCTRL   &kp LGUI  &kp LALT  &kp DOT   &mo 1   &kp LSHFT  &kp SPACE      &kp SPACE  &kp RET &mo 2   &kp LEFT   &kp DOWN &kp UP    &kp RIGHT
            >;
        };

        lower_layer {
            bindings = <
&kp F11     &kp F1     &kp F2    &kp F3    &kp F4    &kp F5     &kp LBRC       &kp RBRC   &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &kp F12
&kp TILDE   &kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT  &kp UNDER      &kp PLUS   &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &kp PIPE
&kp TAB     &kp N1     &kp N2    &kp N3    &kp N4    &kp N5     &kp DEL        &kp BSPC   &kp H      &kp J      &kp K      &kp L      &kp COLON  &kp DQT
&kp LSHFT   &kp N6     &kp N7    &kp N8    &kp N9    &kp N0     &kp SPACE      &kp RET    &kp N      &kp M      &kp LT     &kp GT     &kp QMARK  &kp RSHFT
&kp LCTRL   &kp LGUI   &kp LALT  &kp LA(GRAVE)  &trans  &kp SPACE  &kp DEL    &kp BSPC   &kp RET    &mo 3      &kp HOME   &kp PG_DN  &kp PG_UP  &kp END
            >;
        };

        raise_layer {
            bindings = <
&trans      &kp F1     &kp F2    &kp F3    &kp F4    &kp F5     &kp C_PREV     &kp C_NEXT &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &kp F12
&trans      &kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT  &kp C_VOL_DN   &kp C_VOL_UP &kp CARET &kp AMPS   &kp ASTRK  &kp LPAR   &kp C_PP   &kp PIPE
&kp TAB     &kp N1     &kp N2    &kp N3    &kp N4    &kp N5     &kp C_MUTE     &kp C_STOP &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp COLON  &kp DQT
&kp LSHFT   &kp N6     &kp N7    &kp N8    &kp N9    &kp N0     &kp SPACE      &kp RET    &kp N      &kp M      &kp LT     &kp GT     &kp QMARK  &kp RSHFT
&kp LCTRL   &kp LGUI   &kp LALT  &kp LA(GRAVE)  &mo 3  &kp SPACE  &kp DEL      &kp BSPC   &kp RET    &trans     &kp HOME   &kp PG_DN  &kp PG_UP  &kp END
            >;
        };

        adjust_layer {
            // QMK had bootloader + RGB underglow + backlight keys here.
            // Replaced with bootloader + Bluetooth profile controls (RGB/backlight omitted).
            bindings = <
&trans  &trans        &trans         &trans         &trans         &trans         &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bootloader   &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &trans        &bt BT_CLR    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &sys_reset    &trans         &trans         &trans         &trans         &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans         &trans         &trans         &trans         &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans         &trans         &trans         &trans         &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
